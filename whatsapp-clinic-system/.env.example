# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL / Supabase connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/clinic_whatsapp?schema=public"

# Reminder job cadence (cron expression). Default: every 10 minutes.
REMINDER_CRON="*/10 * * * *"

# How many hours before the appointment to send the "2 hour" reminder
REMINDER_WINDOW_HOURS=2

# Anti-ban artificial delay range (milliseconds)
MIN_SEND_DELAY_MS=2000
MAX_SEND_DELAY_MS=5000

# Sessions folder (Baileys multi-file auth state per clinic)
SESSIONS_DIR=./sessions
